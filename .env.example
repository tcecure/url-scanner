# Copy to .env on each VM and fill in. Never commit a filled-in copy.

# --- database -------------------------------------------------------------
POSTGRES_DB=tcescan
POSTGRES_USER=tcescan
POSTGRES_PASSWORD=
# Web VM: the database is local to this compose project. Worker VM: point at the
# web VM's address on the worker network.
DATABASE_URL=postgres://tcescan:@db:5432/tcescan
# Bind the database to the interface the worker reaches it on, never 0.0.0.0.
DB_BIND=127.0.0.1

# --- public identity (web + worker) ---------------------------------------
PUBLIC_BASE_URL=https://scan.tcecure.com
REVIEWER_INBOX=reviews@tcecure.com
# Salts the hashed submitter IPs in the audit trail. Generate per deployment:
#   openssl rand -hex 32
IP_HASH_SALT=

# --- mail -----------------------------------------------------------------
# `log` records messages in email_outbox without sending, which is how the
# service runs until a TCecure sending identity exists. `smtp` sends them.
MAIL_TRANSPORT=log
MAIL_FROM=no-reply@tcecure.com
MAIL_FROM_NAME=TCecure
MAIL_REPLY_TO=info@tcecure.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- limits, tokens and retention -----------------------------------------
MAX_REQUESTS_PER_IP_PER_HOUR=5
MAX_REQUESTS_PER_EMAIL_PER_DAY=3
MAX_REQUESTS_PER_DOMAIN_PER_WEEK=2
MIN_FORM_SECONDS=4
VERIFY_TOKEN_TTL_HOURS=48
REPORT_LINK_TTL_HOURS=72
RETENTION_DAYS=90

# --- worker only ----------------------------------------------------------
# Public resolvers on purpose: the lab's own resolvers answer for internal names
# this service must never be able to reach.
PUBLIC_RESOLVERS=1.1.1.1,8.8.8.8
WORKER_POLL_SECONDS=3
WORKER_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=120
JOB_MAX_ATTEMPTS=3
